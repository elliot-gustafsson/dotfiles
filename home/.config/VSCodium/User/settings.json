{
    "update.mode": "none",
    "extensions.autoUpdate": "off",
    "extensions.autoCheckUpdates": false,
    // -------------------------------------
    // --- Window & Workbench Appearance ---
    // -------------------------------------
    "explorer.compactFolders": false,
    "explorer.fileNesting.enabled": false,
    "explorer.fileNesting.expand": false,
    "explorer.incrementalNaming": "simple",
    "explorer.autoReveal": "focusNoScroll",
    "extensions.ignoreRecommendations": true,
    "window.commandCenter": false,
    "window.newWindowDimensions": "maximized",
    "window.openFilesInNewWindow": "off",
    "window.openFoldersInNewWindow": "on",
    "window.restoreFullscreen": true,
    "window.title": "${rootName} [${activeEditorMedium}]",
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.restoreViewState": true,
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.tabSizingFixedMaxWidth": 150,
    "workbench.editor.tabSizingFixedMinWidth": 150,
    "workbench.editor.wrapTabs": true,
    "workbench.startupEditor": "none",
    "workbench.tree.indent": 20,
    "workbench.tree.renderIndentGuides": "always",
    "workbench.editorAssociations": {
        "git-rebase-todo": "default"
    },
    // -----------------------
    // --- Editor Behavior ---
    // -----------------------
    "editor.acceptSuggestionOnCommitCharacter": true,
    "editor.autoClosingBrackets": "always",
    "editor.codeActionsOnSave": {},
    "editor.fontFamily": "'Hack Nerd Font', 'monospace', monospace",
    "editor.fontSize": 12,
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.insertSpaces": true,
    "editor.minimap.enabled": false,
    "editor.parameterHints.enabled": false,
    "editor.quickSuggestions": {
        "other": "on"
    },
    "editor.semanticHighlighting.enabled": true,
    "editor.snippetSuggestions": "top",
    "editor.suggest.localityBonus": true,
    "editor.suggest.matchOnWordStartOnly": false,
    "editor.suggestOnTriggerCharacters": true,
    "editor.tabCompletion": "on",
    "editor.tabSize": 4,
    "editor.wordBasedSuggestions": "off",
    "editor.wordWrap": "on",
    // ------------------------------
    // --- Files & Source Control ---
    // ------------------------------
    "files.associations": {
        "CODEOWNERS": "plaintext"
    },
    "files.autoSave": "onFocusChange",
    "files.autoSaveDelay": 5000,
    "files.autoSaveWorkspaceFilesOnly": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "git.enableSmartCommit": true,
    "git.openDiffOnClick": false,
    "git.replaceTagsWhenPull": true,
    "scm.defaultViewMode": "tree",
    "scm.workingSets.enabled": false,
    "security.workspace.trust.untrustedFiles": "open",
    // ----------------------------
    // --- Terminal & Debugging ---
    // ----------------------------
    "debug.console.collapseIdenticalLines": false,
    "debug.console.maximumLines": 999999999999999,
    "debug.terminal.clearBeforeReusing": true,
    "debug.toolBarLocation": "docked",
    "diffEditor.experimental.showMoves": true,
    "diffEditor.hideUnchangedRegions.contextLineCount": 8,
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.maxComputationTime": 0,
    "diffEditor.hideUnchangedRegions.enabled": true,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.scrollback": 999999999999,
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.initialHint": false,
    // -------------------------------------
    // --- Languages: PHP / Intelephense ---
    // -------------------------------------
    "intelephense.codeLens.implementations.enable": true,
    "intelephense.codeLens.overrides.enable": true,
    "intelephense.codeLens.parent.enable": true,
    "intelephense.codeLens.references.enable": true,
    "intelephense.codeLens.usages.enable": true,
    "intelephense.environment.phpVersion": "8.4",
    "intelephense.files.exclude": [
        "**/.git/**",
        "**/.svn/**",
        "**/CVS/**",
        "**/.DS_Store/**",
        "**/node_modules/**"
    ],
    "intelephense.files.maxSize": 100000000000,
    "intelephense.format.braces": "k&r",
    "intelephense.maxMemory": 8192,
    "intelephense.phpdoc.returnVoid": false,
    "intelephense.stubs": [
        "apache",
        "bcmath",
        "bz2",
        "calendar",
        "com_dotnet",
        "Core",
        "ctype",
        "curl",
        "date",
        "dba",
        "dom",
        "enchant",
        "exif",
        "FFI",
        "fileinfo",
        "filter",
        "fpm",
        "ftp",
        "gd",
        "gettext",
        "gmp",
        "hash",
        "iconv",
        "imap",
        "intl",
        "json",
        "ldap",
        "libxml",
        "mbstring",
        "meta",
        "mysqli",
        "oci8",
        "odbc",
        "openssl",
        "pcntl",
        "pcre",
        "PDO",
        "pgsql",
        "Phar",
        "posix",
        "pspell",
        "random",
        "readline",
        "redis",
        "Reflection",
        "session",
        "shmop",
        "SimpleXML",
        "snmp",
        "soap",
        "sockets",
        "sodium",
        "SPL",
        "sqlite3",
        "standard",
        "superglobals",
        "sysvmsg",
        "sysvsem",
        "sysvshm",
        "tidy",
        "tokenizer",
        "xdebug",
        "xml",
        "xmlreader",
        "xmlrpc",
        "xmlwriter",
        "xsl",
        "yaml",
        "Zend OPcache",
        "zip",
        "zlib"
    ],
    "intelephense.telemetry.enabled": false,
    "php.debug.executablePath": "php",
    "php.debug.ideKey": "ELLIOT",
    // -------------------------------------
    // ----------- Languages: Go -----------
    // -------------------------------------
    "go.addTags": {
        "tags": "json,validate",
        "options": "json=omitempty,validate=omitempty",
        "promptForTags": false,
        "transform": "snakecase",
        "template": ""
    },
    "go.formatTool": "goimports",
    "go.lintFlags": [
        "--fast"
    ],
    "go.testFlags": [
        "-count=1",
        "-v"
    ],
    "go.delveConfig": {
        "dlvFlags": [
            "--check-go-version=false"
        ]
    },
    "go.lintOnSave": "workspace",
    "go.lintTool": "golangci-lint",
    "go.toolsEnvVars": {},
    "go.useLanguageServer": true,
    "gopls": {
        "ui.semanticTokens": true,
        "ui.completion.completeFunctionCalls": true,
        "ui.diagnostic.analyses": {
            "unusedparams": true,
            "slicesbackward": false
        }
    },
    // --------------------------------
    // --- Languages: YAML & Others ---
    // --------------------------------
    "html.format.templating": true,
    "makefile.configureOnOpen": true,
    "yaml.completion": true,
    "yaml.format.bracketSpacing": false,
    "yaml.maxItemsComputed": 100000,
    "yaml.schemas": {
        "kubernetes": [
            ""
        ],
        "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/master/v1.33.5-standalone-strict/all.json": [
            "kube/*.yml",
            "kube/*.yaml"
        ]
    },
    "yaml.suggest.parentSkeletonSelectedFirst": true,
    "yaml.trace.server": "messages",
    // -------------------------------------
    // ----------- Languages: Zig -----------
    // -------------------------------------
    "zig.path": "zig",
    "zig.zls.enabled": "on",
    // "zig.buildOnSaveProvider": "extension",
    "zig.buildOnSaveProvider": "zls",
    "zig.zls.additionalOptions": {
        "enable_build_on_save": true,
        // "build_on_save_step": "check",
        "build_on_save_args": [
            "-fincremental"
        ]
    },
    "zig.zls.inlayHintsShowBuiltin": true,
    "lldb.launch.expressions": "native",
    // "zig.testArgs": [
    //     "build",
    //     "test",
    //     "--",
    //     "--test-filter",
    //     "${filter}",
    //     // "${path}"
    // ],
    // ----------------------------
    // --- GitLens & Extensions ---
    // ----------------------------
    "chat.agent.enabled": false,
    "chat.commandCenter.enabled": false,
    "containers.commands.attach": "${containerCommand} exec -it ${containerId} ${shellCommand}",
    "docker.extension.enableComposeLanguageServer": false,
    "gitblame.ignoreWhitespace": true,
    "gitlens.showWelcomeOnInstall": false,
    "gitlens.showWhatsNewAfterUpgrades": false,
    "gitlens.ai.enabled": false,
    "gitlens.plusFeatures.enabled": false,
    "gitlens.advanced.blame.delayAfterEdit": 1000,
    "gitlens.advanced.blame.sizeThresholdAfterEdit": 1000,
    "gitlens.blame.avatars": false,
    "gitlens.blame.compact": false,
    "gitlens.blame.dateFormat": "YYYY-MM-DD",
    "gitlens.blame.format": "${date} ${author|20}",
    "gitlens.blame.separateLines": false,
    "gitlens.currentLine.dateFormat": "YYYY-MM-DD",
    "gitlens.currentLine.enabled": false,
    "gitlens.currentLine.format": "${date} ${author|20}",
    "gitlens.currentLine.uncommittedChangesFormat": "*",
    "gitlens.graph.minimap.dataType": "lines",
    "gitlens.graph.enabled": false,
    "gitlens.graph.minimap.enabled": false,
    "gitlens.hovers.avatars": false,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.statusBar.tooltipFormat": "&nbsp;__${author}__, ${ago}${' via 'pullRequest} &nbsp; _(${date})_ \n\n${message}${\n\n---\n\nfootnotes}\n\n${commands}",
    "gitlens.telemetry.enabled": false,
    "gitlens.views.branches.avatars": false,
    "redhat.telemetry.enabled": false,
    "scratchpads.autoFormat": false,
    "scratchpads.autoPaste": false,
    "scratchpads.scratchpadsFolder": "/var/tmp",
    "telemetry.feedback.enabled": false,
    "telemetry.telemetryLevel": "off",
    "todohighlight.keywordsPattern": "(\/\/|#|<!--)[\\s.]*([T|t][O|o][D|d][O|o]):? .+",
    "todohighlight.defaultStyle": {
        "backgroundColor": "#fac855",
        "color": "#333333",
        "fontStyle": "bold"
    },
    "jsonnet.languageServer.enableAutoUpdate": false,
    "jsonnet.debugger.enableAutoUpdate": false,
    // ------------------------------------
    // --- Theme & Token Customizations ---
    // ------------------------------------
    "workbench.colorCustomizations": {
        "tree.indentGuidesStroke": "#007ACC",
        "editorIndentGuide.activeBackground1": "#007ACC",
        "tree.inactiveIndentGuidesStroke": "#4e4e4e",
        "terminal.background": "#222222",
        "editorGutter.background": "#222222",
        "sideBar.background": "#2c2c2c",
        "editor.background": "#2b2b2b",
        "statusBar.debuggingBackground": "#2b2b2b",
    },
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "string.format": "#CC7832"
        }
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment"
                ],
                "settings": {
                    "foreground": "#7a7e85"
                }
            },
            {
                "scope": [
                    "entity.name.namespace"
                ],
                "settings": {
                    "foreground": "#AFBF7E"
                }
            },
            {
                "scope": [
                    "storage.type",
                    "storage.modifier",
                    "support.function.go",
                    "storage.type.error.go",
                    "storage.type.string.go",
                    "storage.type.boolean.go",
                    "storage.type.byte.go",
                    "storage.type.numeric.go",
                    "constant.language.boolean.go",
                    "entity.name.function.support.builtin.go",
                    "type",
                    "support.constant",
                    "support.type",
                    "support.variable",
                    "variable.language",
                    "constant.language",
                    "constant.language.php",
                    "constant.character.escape",
                    "meta.function.parameters.php",
                    "keyword.control",
                    "keyword.other.type",
                    "keyword.other.new",
                    "keyword.operator.type",
                    "keyword.operator.new",
                    "keyword.other.namespace",
                    "keyword.other.use",
                    "keyword.other.function.use",
                    "keyword.other",
                    "keyword.other.false.go",
                    "keyword",
                    "punctuation.section.embedded.begin.php",
                    "punctuation.section.embedded.end.php",
                    "meta.embedded.assembly",
                    "entity.name.tag",
                    "support.function.construct.output.php",
                    "support.function.construct.php"
                ],
                "settings": {
                    "foreground": "#CC7832",
                    "fontStyle": ""
                }
            },
            {
                "scope": [
                    "support.class",
                    "entity.name.type.class.php",
                    "entity.name.type.interface.php",
                    "entity.other.inherited-class.php",
                    "entity.name.type.namespace.php",
                    "support.class.builtin.php",
                    "support.other.namespace.php",
                    "variable.other.import.go"
                ],
                "settings": {
                    "foreground": "#b2b7bd",
                    "fontStyle": ""
                }
            },
            {
                "scope": [
                    "variable",
                    "variable.other.assignment.go",
                    "variable.other.readwrite",
                    "definition",
                    "support.variable",
                    "entity.name.variable",
                    "entity.other.attribute-name",
                    "punctuation.separator"
                ],
                "settings": {
                    "foreground": "#bcbec4",
                    "fontStyle": ""
                }
            },
            {
                "scope": [
                    "variable.other.php",
                    "variable.other.property.php",
                    "variable.other.global.php",
                    "variable.other.global.safer.php",
                    "constant.other.php",
                    "constant.other.class.php"
                ],
                "settings": {
                    "foreground": "#9876AA",
                    "fontStyle": ""
                }
            },
            {
                "scope": [
                    "entity.name.function",
                    "support.function"
                ],
                "settings": {
                    "foreground": "#FFC66D",
                    "fontStyle": ""
                }
            },
            {
                "scope": [
                    "constant.numeric"
                ],
                "settings": {
                    "foreground": "#2aacB8",
                    "fontStyle": ""
                }
            },
            {
                "scope": [
                    "entity.name.type"
                ],
                "settings": {
                    "foreground": "#6fafbd",
                    "fontStyle": ""
                }
            },
            {
                "scope": [
                    "variable.other.property.php",
                    "support.type.property-name",
                    "variable.other.constant",
                    "support.type.property-name.json"
                ],
                "settings": {
                    "foreground": "#c77dbb",
                    "fontStyle": ""
                }
            },
            {
                "scope": [
                    "string",
                    "entity.name",
                    "comment.block.documentation.phpdoc.php"
                ],
                "settings": {
                    "foreground": "#4e8a63"
                }
            },
            {
                "scope": [
                    "meta.attribute"
                ],
                "settings": {
                    "foreground": "#aca547"
                }
            },
            {
                "scope": [
                    "keyword.definition.arrow.php"
                ],
                "settings": {
                    "foreground": "#D4D4D4"
                }
            }
        ]
    },
    // -----------------------------------
    // --- Language Specific Overrides ---
    // -----------------------------------
    "[go]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "golang.go",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll": "explicit"
        }
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonnet]": {
        "editor.defaultFormatter": "Grafana.vscode-jsonnet"
    },
    "[libsonnet]": {
        "editor.defaultFormatter": "Grafana.vscode-jsonnet"
    },
    "[kiwi]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },
    "[php]": {
        "editor.wordSeparators": "`~!@#%^&*()-=+[{]}\\|;:'\",.<>/?",
        "editor.suggest.showFields": false,
        "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
        "editor.insertSpaces": true
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.tabSize": 2
    },
    "[yml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.tabSize": 2
    },
    "[zig]": {
        // Formatting with ZLS matches `zig fmt`.
        // "editor.formatOnSave": false,
        // "editor.inlayHints.enabled": "off",
        // overwrite words when accepting completions
        "editor.suggest.insertMode": "replace",
        "editor.codeActionsOnSave": {
            // Run code actions that currently supports adding and removing discards.
            // "source.fixAll": "explicit",
            // Run code actions that sorts @import declarations.
            // "source.organizeImports": "explicit",
        }
    },
}
