// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "tabs": {
        "show_diagnostics": "errors",
        "file_icons": true,
        "git_status": true,
    },
    "status_bar": {
        "show_active_file": true,
        "line_endings_button": true,
    },
    "search": {
        "button": true,
        "center_on_match": true,
    },
    "auto_update": false,
    "base_keymap": "VSCode",
    "icon_theme": "Zed (Default)",
    "cli_default_open_behavior": "new_window",
    // -------------------------
    // --- UI & Panel Layout ---
    // -------------------------
    "ui_font_size": 14,
    "title_bar": {
        "show_user_picture": false,
        "show_project_items": true,
        "show_worktree_name": false,
        "show_branch_status_icon": true,
        "show_sign_in": false,
        "show_user_menu": false,
    },
    "gutter": {
        "min_line_number_digits": 2,
        "folds": false,
        "runnables": true,
        "breakpoints": true,
    },
    "diagnostics": {
        "button": false,
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "button": false,
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
        "default_width": 350,
        "file_icons": true,
        "tree_view": true,
        "group_by": "staging",
        "entry_primary_click_action": "view_file",
    },
    "project_panel": {
        "dock": "left",
        "default_width": 350,
        "auto_fold_dirs": false,
        "auto_reveal_entries": false,
        "indent_size": 16,
        "entry_spacing": "standard",
    },
    "debugger": {
        "dock": "left",
    },
    "disable_ai": true,
    "agent": {
        "enabled": false,
        "button": false,
    },
    "preview_tabs": {
        "enabled": true,
        "enable_preview_file_from_code_navigation": true,
        "enable_keep_preview_on_code_navigation": false,
        "enable_preview_multibuffer_from_code_navigation": true,
    },
    "restore_on_file_reopen": true,
    "reveal_if_open": true,
    // -----------------------
    // --- Editor Behavior ---
    // -----------------------
    "buffer_font_family": "Hack Nerd Font",
    "buffer_font_size": 11.5,
    // "buffer_font_fallbacks": ["monospace", "monospace"],
    "buffer_font_features": {
        "calt": false,
    },
    "tab_size": 4,
    "hard_tabs": true,
    "soft_wrap": "editor_width",
    // "format_on_save": "on",
    "auto_indent_on_paste": true,
    "use_autoclose": true,
    "lsp_results_location": "picker",
    "auto_signature_help": false,
    "show_signature_help_after_edits": false,
    "show_completions_on_input": true,
    "semantic_tokens": "combined",
    "colorize_brackets": true,
    "indent_guides": {
        "enabled": true,
    },
    "minimap": {
        "show": "never",
    },
    "completions": {
        // "words": false,
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
    },
    // ------------------------------
    // --- Files & Source Control ---
    // ------------------------------
    "autosave": "on_focus_change",
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "file_types": {
        // "plaintext": ["CODEOWNERS"],
    },
    "git": {
        "inline_blame": {
            "enabled": false,
        },
        "blame": {
            "show_avatar": false,
        },
    },
    // ----------------------------
    // --- Terminal & Telemetry ---
    // ----------------------------
    "terminal": {
        "font_size": 12.0,
        "blinking": "on",
        "max_scroll_history_lines": 999999999999,
        "minimum_contrast": 0,
        "default_height": 360,
        "starts_open": true,
        "show_count_badge": true,
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    // -----------------------------
    // --- Theme & Custom Colors ---
    // -----------------------------
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "One Dark",
    },
    "theme_overrides": {
        "One Dark": {
            "players": [
                {
                    "cursor": "#ffffff", // change to your preferred color (e.g., #ffffff, #dce0e5, #528bff)
                },
            ],
            "editor.background": "#2b2b2b",
            "editor.gutter.background": "#222222",
            "terminal.background": "#222222",
            "panel.background": "#2c2c2c",
            "syntax": {
                "comment": {
                    "color": "#7a7e85",
                },
                "keyword": {
                    "color": "#CC7832",
                },
                "keyword.operator": {
                    "color": "#CC7832",
                },
                "keyword.function": {
                    "color": "#CC7832",
                },
                "string": {
                    "color": "#4e8a63",
                },
                "string.escape": {
                    "color": "#CC7832",
                },
                // Functions & Methods
                "function": {
                    "color": "#FFC66D",
                },
                "function.call": {
                    "color": "#FFC66D",
                },
                "function.method": {
                    "color": "#FFC66D",
                },
                "function.method.call": {
                    "color": "#FFC66D",
                },
                "function.builtin": {
                    "color": "#FFC66D",
                }, // copy, append, make, clear
                // Types
                "type": {
                    "color": "#6fafbd",
                },
                "type.builtin": {
                    "color": "#CC7832",
                }, // string, int, bool, error
                "include": {
                    "color": "#CC7832",
                },
                "repeat": {
                    "color": "#CC7832",
                },
                "conditional": {
                    "color": "#CC7832",
                },
                // Identifiers & Fields
                "variable": {
                    "color": "#bcbec4",
                },
                "variable.parameter": {
                    "color": "#bcbec4",
                },
                "variable.builtin": {
                    "color": "#CC7832",
                },
                "field": {
                    "color": "#bcbec4",
                },
                "property": {
                    // "color": "#bcbec4",
                    "color": "#CC7832",
                },
                "property.json_key": {
                    "color": "#c77dbb",
                }, // JSON keys only
                "property.yaml_key": {
                    "color": "#CC7832",
                },
                "namespace": {
                    "color": "#AFBF7E",
                }, // package main, fmt, os
                "define": {
                    "color": "#bcbec4",
                },
                "punctuation.special": {
                    "color": "#6fafbd",
                }, // :: and ::: delimiters
                // Constants, Literals, Operators
                "number": {
                    "color": "#2aacB8",
                },
                "boolean": {
                    "color": "#CC7832",
                },
                "constant.builtin": {
                    "color": "#CC7832",
                },
                "constant": {
                    "color": "#c77dbb",
                },
                "operator": {
                    "color": "#bcbec4",
                },
                "punctuation": {
                    "color": "#bcbec4",
                },
            },
        },
    },
    // -----------------------------------
    //--- Common LSP & Semantic Rules ---
    // -----------------------------------
    "global_lsp_settings": {
        "semantic_token_rules": [
            {
                "token_type": "property",
                "foreground_color": "#bcbec4", // Code properties from LSP -> Grey
            },
            {
                "token_type": "type",
                "token_modifiers": ["defaultLibrary"],
                "style": ["type.builtin"],
            },
            {
                "token_type": "variable",
                "token_modifiers": ["defaultLibrary"],
                "style": ["constant.builtin"],
            },
            {
                "token_type": "variable",
                "token_modifiers": ["readonly"],
                "style": ["constant"],
            },
            {
                "token_type": "string",
                "token_modifiers": ["format"],
                "style": ["string.escape"],
            },
        ],
    },
    // -----------------------------------
    // --- Language Specific Overrides ---
    // -----------------------------------
    "languages": {
        "Go": {
            "format_on_save": "on",
            "formatter": {
                "language_server": {
                    "name": "gopls",
                },
            },
            "code_actions_on_format": {
                "source.organizeImports": true,
            },
        },
        "Zig": {
            "format_on_save": "on",
        },
        "PHP": {
            "tab_size": 4,
            "hard_tabs": false,
            "format_on_save": "modifications",
            "language_servers": ["phpantom", "!intelephense", "!phpactor"],
        },
        "JSON": {
            "format_on_save": "on",
            "hard_tabs": false,
        },
        "JSONC": {
            "format_on_save": "on",
            "hard_tabs": false,
        },
        "YAML": {
            "format_on_save": "on",
            "hard_tabs": false,
            "tab_size": 2,
        },
        "Jsonnet": {
            "format_on_save": "on",
            "tab_size": 4,
            "language_servers": ["jsonnet-language-server"],
        },
    },
    // -------------------------------------
    // --- Language Server Configurations ---
    // -------------------------------------
    "lsp": {
        "gopls": {
            "initialization_options": {
                "completeUnimported": true,
                "usePlaceholders": true,
                "semanticTokens": true,
                "analyses": {
                    "unusedparams": true,
                    "slicesbackward": false,
                },
            },
        },
        "zls": {
            "initialization_options": {
                "enable_build_on_save": true,
                "build_on_save_args": ["-fincremental"],
                "inlay_hints_show_builtin": true,
            },
        },
        "yaml-language-server": {
            "settings": {
                "yaml": {
                    "schemas": {
                        "kubernetes": [""],
                        "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/master/v1.35.8-standalone-strict/all.json": [
                            "kube/*.yml",
                            "kube/*.yaml",
                        ],
                    },
                    "format": {
                        "bracketSpacing": false,
                    },
                },
            },
        },
        "jsonnet-language-server": {
            "binary": {
                "path": "jsonnet-language-server",
                "arguments": ["--lint"],
            },
            "settings": {
                "resolve_paths_with_tanka": true,
                "jpath": ["vendor", "lib"],
            },
        },
        "phpantom": {
            "binary": {
                "path": "phpantom_lsp",
            },
        },
    },
}
