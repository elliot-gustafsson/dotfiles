// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "auto_update": false,
    "base_keymap": "VSCode",
    "icon_theme": "Zed (Default)",
    "cli_default_open_behavior": "new_window",
    // -------------------------
    // --- UI & Panel Layout ---
    // -------------------------
    "ui_font_size": 14,
    "title_bar": {
        "show_sign_in": false,
        "show_user_menu": false,
    },
    "diagnostics": {
        "button": false,
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "button": false,
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "project_panel": {
        "dock": "left",
        "auto_fold_dirs": false,
        "auto_reveal_entries": true,
        "indent_size": 20,
    },
    "agent": {
        "enabled": false,
        "button": false,
    },
    "preview_tabs": {
        "enabled": true,
        "enable_preview_file_from_code_navigation": true,
        "enable_keep_preview_on_code_navigation": false,
        "enable_preview_multibuffer_from_code_navigation": true,
    },
    "restore_on_file_reopen": true,
    "reveal_if_open": true,
    // -----------------------
    // --- Editor Behavior ---
    // -----------------------
    "buffer_font_family": "Hack Nerd Font",
    "buffer_font_size": 12.0,
    // "buffer_font_fallbacks": ["monospace", "monospace"],
    "tab_size": 4,
    "hard_tabs": true,
    "soft_wrap": "editor_width",
    // "format_on_save": "on",
    "auto_indent_on_paste": true,
    "use_autoclose": true,
    "lsp_results_location": "picker",
    "auto_signature_help": false,
    "show_signature_help_after_edits": false,
    "show_completions_on_input": true,
    "semantic_tokens": "combined",
    "colorize_brackets": true,
    "indent_guides": {
        "enabled": true,
    },
    "minimap": {
        "show": "never",
    },
    "completions": {
        // "words": false,
    },
    "toolbar": {
        "breadcrumbs": false,
        "quick_actions": false,
    },
    // ------------------------------
    // --- Files & Source Control ---
    // ------------------------------
    "autosave": "on_focus_change",
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "file_types": {
        "plaintext": ["CODEOWNERS"],
        "Jsonnet": ["jsonnet", "libsonnet"],
    },
    "git": {
        "inline_blame": {
            "enabled": false,
        },
        "blame": {
            "show_avatar": false,
        },
    },
    // ----------------------------
    // --- Terminal & Telemetry ---
    // ----------------------------
    "terminal": {
        "font_size": 13.0,
        "blinking": "on",
        "max_scroll_history_lines": 999999999999,
        "minimum_contrast": 0,
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    // -----------------------------
    // --- Theme & Custom Colors ---
    // -----------------------------
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "One Dark",
    },
    "theme_overrides": {
        "One Dark": {
            "editor.background": "#2b2b2b",
            "editor.gutter.background": "#222222",
            "terminal.background": "#222222",
            "panel.background": "#2c2c2c",
            "syntax": {
                "comment": { "color": "#7a7e85" },
                "keyword": { "color": "#CC7832" },
                "keyword.operator": { "color": "#CC7832" },
                "keyword.function": { "color": "#CC7832" },
                "string": { "color": "#4e8a63" },
                "string.escape": { "color": "#CC7832" },

                // Functions & Methods
                "function": { "color": "#FFC66D" },
                "function.call": { "color": "#FFC66D" },
                "function.method": { "color": "#FFC66D" },
                "function.method.call": { "color": "#FFC66D" },
                "function.builtin": { "color": "#FFC66D" }, // copy, append, make, clear

                // Types
                "type": { "color": "#6fafbd" },
                "type.builtin": { "color": "#CC7832" }, // string, int, bool, error
                "include": { "color": "#CC7832" },
                "repeat": { "color": "#CC7832" },
                "conditional": { "color": "#CC7832" },

                // Identifiers & Fields
                "variable": { "color": "#bcbec4" },
                "variable.parameter": { "color": "#bcbec4" },
                "variable.builtin": { "color": "#CC7832" },
                "field": { "color": "#bcbec4" },
                "property": { "color": "#bcbec4" },
                "property.json_key": { "color": "#c77dbb" }, // JSON keys only
                "namespace": { "color": "#AFBF7E" }, // package main, fmt, os
                "define": { "color": "#6fafbd" }, // local field definitions (hidden)
                "punctuation.special": { "color": "#6fafbd" }, // :: and ::: delimiters

                // Constants, Literals, Operators
                "number": { "color": "#2aacB8" },
                "boolean": { "color": "#CC7832" },
                "constant.builtin": { "color": "#CC7832" },
                "constant": { "color": "#c77dbb" },
                "operator": { "color": "#bcbec4" },
                "punctuation": { "color": "#bcbec4" },
            },
        },
    },
    // -----------------------------------
    //--- Common LSP & Semantic Rules ---
    // -----------------------------------
    "global_lsp_settings": {
        "semantic_token_rules": [
            {
                "token_type": "type",
                "token_modifiers": ["defaultLibrary"],
                "style": ["type.builtin"],
            },
            {
                "token_type": "variable",
                "token_modifiers": ["defaultLibrary"],
                "style": ["constant.builtin"],
            },
            {
                "token_type": "variable",
                "token_modifiers": ["readonly"],
                "style": ["constant"],
            },
            {
                "token_type": "string",
                "token_modifiers": ["format"],
                "style": ["string.escape"],
            },
        ],
    },
    // -----------------------------------
    // --- Language Specific Overrides ---
    // -----------------------------------
    "languages": {
        "Go": {
            "format_on_save": "on",
            "formatter": {
                "language_server": {
                    "name": "gopls",
                },
            },
            "code_actions_on_format": {
                "source.organizeImports": true,
            },
        },
        "Zig": {
            "format_on_save": "on",
        },
        "PHP": {
            "tab_size": 4,
            "hard_tabs": false,
            "format_on_save": "modifications",
            "language_servers": ["intelephense", "!phpactor"],
        },
        "JSON": {
            "format_on_save": "on",
            "hard_tabs": false,
        },
        "JSONC": {
            "format_on_save": "on",
            "hard_tabs": false,
        },
        "YAML": {
            "format_on_save": "on",
            "hard_tabs": false,
        },
        "Jsonnet": {
            "tab_size": 4,
            "language_servers": ["jsonnet-language-server"],
        },
    },
    // -------------------------------------
    // --- Language Server Configurations ---
    // -------------------------------------
    "lsp": {
        "gopls": {
            "initialization_options": {
                "completeUnimported": true,
                "usePlaceholders": true,
                "semanticTokens": true,
                "analyses": {
                    "unusedparams": true,
                    "slicesbackward": false,
                },
            },
        },
        "zls": {
            "initialization_options": {
                "enable_build_on_save": true,
                "build_on_save_args": ["-fincremental"],
                "inlay_hints_show_builtin": true,
            },
        },
        "yaml-language-server": {
            "settings": {
                "yaml": {
                    "schemas": {
                        "kubernetes": [""],
                        "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/master/v1.33.5-standalone-strict/all.json": [
                            "kube/*.yml",
                            "kube/*.yaml",
                        ],
                    },
                    "format": {
                        "bracketSpacing": false,
                    },
                },
            },
        },
        "jsonnet-language-server": {
            "binary": {
                "path": "jsonnet-language-server",
                "arguments": ["--lint"],
            },
            "settings": {
                "resolve_paths_with_tanka": true,
                "jpath": ["vendor", "lib"],
            },
        },
        "intelephense": {
            "initialization_options": {
                "environment": {
                    "phpVersion": "8.4",
                },
                "format": {
                    "braces": "k&r",
                },
                "files": {
                    "maxSize": 100000000,
                },
                "phpdoc": {
                    "returnVoid": false,
                },
                "stubs": [
                    "apache",
                    "bcmath",
                    "bz2",
                    "calendar",
                    "com_dotnet",
                    "Core",
                    "ctype",
                    "curl",
                    "date",
                    "dba",
                    "dom",
                    "enchant",
                    "exif",
                    "FFI",
                    "fileinfo",
                    "filter",
                    "fpm",
                    "ftp",
                    "gd",
                    "gettext",
                    "gmp",
                    "hash",
                    "iconv",
                    "imap",
                    "intl",
                    "json",
                    "ldap",
                    "libxml",
                    "mbstring",
                    "meta",
                    "mysqli",
                    "oci8",
                    "odbc",
                    "openssl",
                    "pcntl",
                    "pcre",
                    "PDO",
                    "pgsql",
                    "Phar",
                    "posix",
                    "pspell",
                    "random",
                    "readline",
                    "redis",
                    "Reflection",
                    "session",
                    "shmop",
                    "SimpleXML",
                    "snmp",
                    "soap",
                    "sockets",
                    "sodium",
                    "SPL",
                    "sqlite3",
                    "standard",
                    "superglobals",
                    "sysvmsg",
                    "sysvsem",
                    "sysvshm",
                    "tidy",
                    "tokenizer",
                    "xdebug",
                    "xml",
                    "xmlreader",
                    "xmlrpc",
                    "xmlwriter",
                    "xsl",
                    "yaml",
                    "Zend OPcache",
                    "zip",
                    "zlib",
                ],
            },
        },
    },
}
