    {
        "label": "Debug Zig Tests",
        "adapter": "CodeLLDB",
        "request": "launch",
        "program": "$ZED_WORKTREE_ROOT/zig-out/bin/test-bin",
        "cwd": "$ZED_WORKTREE_ROOT",
        "expressions": "native",
        "breakpointMode": "file",
        "stopOnEntry": false,
        "build": {
            "command": "zig",
            "args": [
                "test",
                "-fllvm",
                "--test-no-exec",
                "$ZED_FILE",
                "-femit-bin=$ZED_WORKTREE_ROOT/zig-out/bin/test-bin",
            ],
            "cwd": "$ZED_WORKTREE_ROOT",
        },
    },
]
