FROM docker.io/library/ubuntu:24.04 AS builder

ARG ZIG_VERSION=0.15.2
ARG GHOSTTY_VERSION=1.3.1

ENV DEBIAN_FRONTEND=noninteractive

# 1. Install build dependencies
RUN apt-get update && apt-get install -y \
    libgtk-4-dev \
    libadwaita-1-dev \
    gettext \
    pkg-config \
    curl \
    tar \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Zig
RUN curl -sSL https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz | tar -xJ -C /tmp && \
    mv /tmp/zig-x86_64-linux-${ZIG_VERSION} /opt/zig

# 3. Build Ghostty directly for /usr
RUN mkdir -p /tmp/ghostty /tmp/zig-cache /tmp/zig-global-cache /tmp/ghostty-install && \
    curl -sSL https://release.files.ghostty.org/${GHOSTTY_VERSION}/ghostty-${GHOSTTY_VERSION}.tar.gz | tar -xz -C /tmp/ghostty --strip-components=1 && \
    cd /tmp/ghostty && \
    DESTDIR=/tmp/ghostty-install /opt/zig/zig build \
    --cache-dir /tmp/zig-cache \
    --global-cache-dir /tmp/zig-global-cache \
    -Doptimize=ReleaseFast \
    -Dcpu=native \
    -fno-sys=gtk4-layer-shell \
    -p /usr

FROM scratch
COPY --from=builder /tmp/ghostty-install/usr/bin/ /bin/
COPY --from=builder /tmp/ghostty-install/usr/share/ /share/
COPY --from=builder /tmp/ghostty-install/usr/lib/ /lib/
